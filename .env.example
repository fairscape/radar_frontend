# Backend base URL the React app talks to. Override per environment.
VITE_API_BASE_URL=http://localhost:8000

# Set to 1 to bypass the network and use the in-tree mock module
# (``src/mock-api/``) — useful for offline demos and storybook-style
# UI work. Defaults to 0 (real backend).
VITE_USE_MOCK=0
