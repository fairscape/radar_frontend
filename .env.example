# Backend base URL. Leave empty in dev: the Vite dev server proxies /api to
# VITE_DEV_BACKEND (default http://localhost:8000). Set it for builds that
# talk to a backend on another origin.
VITE_API_BASE_URL=

# Dev-server overrides.
VITE_DEV_PORT=5173
VITE_DEV_BACKEND=http://localhost:8000

# 1 = answer /api/* from the in-browser mock (src/mock/) instead of a backend.
# Sign in as demo@example.com for seeded data, or any other email for a fresh account.
VITE_USE_MOCK=0
